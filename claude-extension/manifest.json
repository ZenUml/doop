{
  "manifest_version": "0.3",
  "name": "diagramly",
  "display_name": "Diagramly",
  "version": "0.1.1",
  "description": "Create and revise editable diagrams with Claude and Diagramly Desktop.",
  "author": {
    "name": "Diagramly",
    "url": "https://diagramly.ai"
  },
  "homepage": "https://diagramly.ai",
  "documentation": "https://github.com/ZenUml/doop/tree/main/claude-extension",
  "support": "https://github.com/ZenUml/doop/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenUml/doop"
  },
  "license": "AGPL-3.0-only",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "proxy.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/proxy.mjs",
        "${user_config.server_url}",
        "--transport",
        "http-only",
        "--auth-timeout",
        "300",
        "--static-oauth-client-metadata",
        "{\"client_name\":\"Diagramly for Claude Desktop\",\"client_uri\":\"https://diagramly.ai\"}"
      ]
    }
  },
  "user_config": {
    "server_url": {
      "type": "string",
      "title": "Diagramly server URL",
      "description": "Paste the local MCP URL shown in Diagramly Desktop under Connect AI \u2192 Claude. This keeps Claude connected to the selected local library.",
      "required": true
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32"],
    "runtimes": {
      "node": ">=20.18.1"
    }
  },
  "tools_generated": true,
  "keywords": ["diagramly", "mermaid", "zenuml", "architecture", "mcp", "claude"]
}
