{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "app-store",
  "description": "Diagramly Mac App Store shell. Runtime grant uses only the bundled server's exact loopback origin. StoreKit has its own native main-frame origin gate.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "deep-link:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://**" }] },
    "allow-codex-add-mcp",
    "allow-fonts-choose-local",
    "allow-fonts-read-local",
    "allow-view-menu-state",
    "allow-app-menu-set",
    "allow-app-menu-state"
  ]
}
